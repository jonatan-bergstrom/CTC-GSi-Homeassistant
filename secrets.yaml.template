# ESPHome Secrets Template
# Copy this file to 'secrets.yaml' and fill in your actual values
# Never commit the actual secrets.yaml file to git!

# WiFi Credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback Access Point Password
ap_password: "FallbackAPPassword123"

# Home Assistant API Encryption Key
# Generate with: openssl rand -base64 32
api_encryption_key: "your-random-32-byte-base64-key-here"

# OTA Update Password
ota_password: "YourOTAPassword123"
